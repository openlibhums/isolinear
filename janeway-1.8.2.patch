From f91cce4fdf7771f844b99914710263b89e364cf4 Mon Sep 17 00:00:00 2001
From: Andy Byers <a.byers@bbk.ac.uk>
Date: Thu, 22 Oct 2026 12:43:08 +0100
Subject: [PATCH] feat: backport isolinear hooks and setting to 1.8.2

---
 src/security/decorators.py                    |  6 +++++
 .../admin/elements/article_jump.html          |  3 +++
 src/templates/admin/review/in_review.html     |  2 ++
 .../admin/review/unassigned_article.html      |  3 +++
 src/themes/OLH/templates/journal/article.html | 22 +++++++++++++++++--
 src/utils/install/journal_defaults.json       | 19 ++++++++++++++++
 6 files changed, 53 insertions(+), 2 deletions(-)

diff --git a/src/security/decorators.py b/src/security/decorators.py
index b2351d266..51df18669 100755
--- a/src/security/decorators.py
+++ b/src/security/decorators.py
@@ -747,6 +747,12 @@ def article_stage_accepted_or_later_required(func):
         article_object = models.Article.get_article(
             request.journal, identifier_type, identifier
         )
+        # Isolinear patch for 1.8.2: can be removed when upgrading to 1.9
+        if article_object and article_object.journal.get_setting(
+            "general",
+            "uses_isolinear_plugin",
+        ):
+            return func(request, *args, **kwargs)
 
         if article_object is None or not article_object.is_accepted():
             deny_access(request)
diff --git a/src/templates/admin/elements/article_jump.html b/src/templates/admin/elements/article_jump.html
index 4ba88097c..c71cd0ca8 100644
--- a/src/templates/admin/elements/article_jump.html
+++ b/src/templates/admin/elements/article_jump.html
@@ -1,5 +1,6 @@
 {% load securitytags %}
 {% load next_url %}
+{% load hooks %}{# Isolinear patch for 1.8.2: can be removed when upgrading to 1.9 #}
 
 {% is_editor as editor %}
 {% is_section_editor as section_editor %}
@@ -37,6 +38,8 @@
             <li><a target="_blank" href="/admin/submission/article/{{ article.pk }}/">Admin <i
                     class="fa fa-cogs"></i></a></li>
         {% endif %}
+        {# Isolinear patch for 1.8.2: can be removed when upgrading to 1.9 #}
+        {% hook 'logs_documents' %}
     </ul>
   </div>
 
diff --git a/src/templates/admin/review/in_review.html b/src/templates/admin/review/in_review.html
index e5fb18e5d..88e7e72dd 100644
