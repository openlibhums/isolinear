                     </ul>
                 </div>
             </div>
diff --git a/src/templates/admin/review/unassigned_article.html b/src/templates/admin/review/unassigned_article.html
index 0ff980280..07c743f6c 100644
--- a/src/templates/admin/review/unassigned_article.html
+++ b/src/templates/admin/review/unassigned_article.html
@@ -1,5 +1,6 @@
 {% extends "admin/core/base.html" %}
 {% load static roles i18n securitytags %}
+{% load hooks %}{# Isolinear patch for 1.8.2: can be removed when upgrading to 1.9 #}
 
 {% block title %}Unassigned {{ article.title }}{% endblock %}
 {% block title-section %}Unassigned{% endblock %}
@@ -284,6 +285,8 @@
                                     class="fa fa-check-circle action-icon">&nbsp;</i>Accept Article</a></li>
                             <li><a href="{% url 'review_decision' article.id 'decline' %}"><i
                                     class="fa fa-minus-circle action-icon">&nbsp;</i>Decline Article</a></li>
+                            {# Isolinear patch for 1.8.2: can be removed when upgrading to 1.9 #}
+                            {% hook 'unassigned_additional_actions' %}
                         </ul>
                     {% else %}
                         <div class="bs-callout bs-callout-info">
diff --git a/src/themes/OLH/templates/journal/article.html b/src/themes/OLH/templates/journal/article.html
index 4bb98e681..b8bc67a97 100644
--- a/src/themes/OLH/templates/journal/article.html
+++ b/src/themes/OLH/templates/journal/article.html
@@ -144,7 +144,12 @@
                 {% endif %}
                             {% if article.abstract and article.abstract != ''%}
                                 <h3>{% trans "Abstract" %}</h3>
-                                <p>{{ article.abstract|safe }}</p>
+                                {# Isolinear patch for 1.8.2: can be removed when upgrading to 1.9 #}
+                                {% if journal_settings.general.uses_isolinear_plugin and not article.is_published %}
+                                    {% hook 'preprint_abstract_block' article.abstract %}
+                                {% else %}
+                                    <p>{{ article.abstract|safe }}</p>
+                                {% endif %}
                             {% endif %}
                             {% if article.keywords.count > 0 %}<p><strong>{% trans "Keywords" %}:</strong> {% for keyword in article.keywords.all %}{% if journal_settings.general.keyword_list_page %}<a href="{% url 'keyword' keyword.pk %}">{% endif %}{{ keyword.word }}{% if journal_settings.general.keyword_list_page %}</a>{% endif %}{% if not forloop.last %}, {% endif %}{% endfor %}</p>{% endif %}
                             {% if article.is_published or proofing %}
@@ -248,6 +253,9 @@
                                         {% endif %}
                                             {% if article.peer_reviewed %}
                                                 <p>{% trans "Peer Reviewed" %}</p>
+                                            {# Isolinear patch for 1.8.2: can be removed when upgrading to 1.9 #}
+                                            {% elif journal_settings.general.uses_isolinear_plugin and not article.is_published %}
+                                                <h5>Preprint Under Review</h5>
                                             {% endif %}
                                         </div>
                                         {% if article.date_published or article.date_accepted or proofing %}
@@ -271,6 +279,8 @@
                                     </div>
                                 </article>
                             {% endif %}
+                            {# Isolinear patch for 1.8.2: can be removed when upgrading to 1.9 #}
+                            {% hook 'article_content' %}
                         </div>
                     </div>
                 </div>
@@ -310,13 +320,20 @@
                                     {% else %}
                                         <p> {% trans 'Downloads are not available for this article.' %}</p>
                                     {% endif %}
+                                {# Isolinear patch for 1.8.2: can be removed when upgrading to 1.9 #}
+                                {% elif journal_settings.general.uses_isolinear_plugin and article.preprint %}
+                                    <h3>{% trans "Download" %}</h3>
+                                    {% hook 'preprint_version_downloads' %}
                                 {% else %}
                                     <p> {% trans 'Downloads are not available until this article is published ' %}</p>
                                 {% endif %}
                             </div>
+                            {# Isolinear patch for 1.8.2: can be removed when upgrading to 1.9 #}
+                            {% if article.is_published or proofing %}
                             <div class="section">
                             {% include "elements/journal/article_issue_list.html" %}
                             </div>
+                            {% endif %}
                         {% with article.get_doi_url as doi_url %}
                         {% if doi_url %}
                          <div class="section">
@@ -407,7 +424,8 @@
                         </div>
                         {% endfor %}
 
-                        {% if article.preprint and article.preprint.is_published %}
+                        {# Isolinear patch for 1.8.2: can be removed when upgrading to 1.9 #}
+                        {% if article.preprint and article.preprint.is_published and not journal_settings.general.uses_isolinear_plugin %}
                         <div class="section hide-for-small-only">
                             <h3>{{ article.preprint.repository.object_name }}</h3>
                             <p>This article is linked to a {{ article.preprint.repository.object_name }} in {{ article.preprint.repository.name }}.</p>
